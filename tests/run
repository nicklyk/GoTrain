#!/usr/bin/env python3
"""Regression tests for the GoTrain PWA.

Run with no arguments:  tests/run

Two layers. The static checks need nothing but python3 and catch the whole
class of mistakes this single-file app is prone to: a translation key that
exists in one language and not the other, a key defined twice so the first
silently never renders, a string nothing reads any more, a version marker left
behind, an asset the service worker precaches that is not in the repo.

The behavioural checks drive the real app in headless Chromium. They are
skipped, loudly, when no browser is present -- so this suite is still worth
running somewhere without one, it just tells you what it could not check.

Nothing here touches the network or the live site.
"""

import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INDEX = ROOT / "index.html"
SW = ROOT / "sw.js"
MANIFEST = ROOT / "manifest.json"

passed = 0
skipped = 0
failures = []


def check(name, got, want):
    global passed
    if got == want:
        passed += 1
        print(f"  ok   {name}")
    else:
        failures.append(f"{name}\n       got  {got!r}\n       want {want!r}")
        print(f"  FAIL {name}\n       got  {got!r}\n       want {want!r}")


def skip(name, why):
    global skipped
    skipped += 1
    print(f"  skip {name} ({why})")


def source():
    return INDEX.read_text()


def app_script():
    """The last <script> block, which is the whole application."""
    return re.findall(r"<script>(.*?)</script>", source(), re.S)[-1]


# ── translations ─────────────────────────────────────────────────────────
def translation_tables():
    lines = source().split("\n")
    start = next(i for i, l in enumerate(lines) if l.startswith("const T = {"))
    de = next(i for i in range(start, len(lines)) if lines[i].strip().startswith("de: {"))
    en = next(i for i in range(de, len(lines)) if lines[i].strip().startswith("en: {"))
    end = next(i for i in range(en, len(lines)) if lines[i].startswith("};"))

    def keys(a, b):
        out = []
        for line in lines[a + 1:b]:
            out += re.findall(r"'([a-z0-9][a-zA-Z0-9._-]*)'\s*:", line)
        return out

    return keys(de, en), keys(en, end)


def test_translations():
    print("\ntranslations")
    de, en = translation_tables()
    check("both languages define the same keys", sorted(set(de)), sorted(set(en)))
    # A key written twice in one object literal silently loses its first value.
    # That had happened twice here before anything checked for it.
    check("no duplicate keys in German", [k for k in set(de) if de.count(k) > 1], [])
    check("no duplicate keys in English", [k for k in set(en) if en.count(k) > 1], [])

    defined = set(de)
    src = source()
    # Every quoted string inside a t(...) call, not just t('literal') -- keys
    # are also reached through ternaries, as in t(on ? 'sw.stop' : 'sw.start').
    used = set()
    for call in re.findall(r"\bt\(([^()]*)\)", src):
        used |= set(re.findall(r"'([a-z0-9][a-zA-Z0-9._-]*)'", call))
    used |= set(re.findall(r'data-i="([a-z0-9][a-zA-Z0-9._-]*)"', src))
    # And keys built by concatenation, as in t('muscle.' + value). The prefix
    # covers every key beneath it; there is no literal to match.
    prefixes = re.findall(r"\bt\('([a-z0-9][a-zA-Z0-9._-]*\.)'\s*\+", src)
    covered = {k for k in defined if any(k.startswith(p) for p in prefixes)}

    used -= set(prefixes)          # a prefix is not itself a key
    # Every key asked for at runtime must exist, or the UI renders the key
    # name. t() falls back silently, so nothing else would catch a typo.
    check("every key used is defined", sorted(used - defined), [])
    # And the reverse: strings nothing reads are dead weight that drifts out
    # of date and gets translated for no reason.
    check("no orphaned strings", sorted(defined - used - covered), [])


# ── the shipped build ────────────────────────────────────────────────────
def test_version_markers():
    print("\nversion markers")
    src = source()
    version = re.search(r"const APP_VERSION='(\d+)'", src).group(1)
    build = re.search(r"const APP_BUILD='(\d{4}-\d{2}-\d{2})'", src).group(1)
    cache = re.search(r"const CACHE_NAME = 'gotrain-v(\d+)'", SW.read_text()).group(1)
    # Without the cache bump the phone keeps serving the old page, so the
    # version on screen would report a build the user is not running.
    check("APP_VERSION matches CACHE_NAME", version, cache)
    check("APP_BUILD is a plausible date", bool(re.match(r"20\d\d-\d\d-\d\d", build)), True)


def test_service_worker_assets():
    print("\nservice worker")
    sw = SW.read_text()
    assets = re.search(r"const ASSETS = \[(.*?)\];", sw, re.S).group(1)
    paths = re.findall(r"'\./([^']*)'", assets)
    missing = [p for p in paths if p and not (ROOT / p).exists()]
    # A precached path that does not exist makes install() reject, and the
    # whole service worker fails to install -- silently, offline stops working.
    check("every precached asset exists", missing, [])
    check("the shell is precached", "index.html" in paths, True)


def test_manifest():
    print("\nmanifest")
    m = json.loads(MANIFEST.read_text())
    check("display is standalone", m["display"], "standalone")
    for icon in m["icons"]:
        check(f"icon {icon['src']} exists", (ROOT / icon["src"]).exists(), True)

    def png_size(path):
        head = Path(path).read_bytes()[:33]
        return "x".join(str(n) for n in struct.unpack(">II", head[16:24]))

    for shot in m.get("screenshots", []):
        p = ROOT / shot["src"]
        if not p.exists():
            check(f"screenshot {shot['src']} exists", False, True)
            continue
        # A declared size that does not match the file makes the install
        # prompt drop the screenshot without saying why.
        check(f"{shot['src']} matches its declared size", png_size(p), shot["sizes"])


def test_syntax_and_licence():
    print("\nsource")
    node = shutil.which("node")
    if node:
        with tempfile.TemporaryDirectory() as d:
            js = Path(d) / "app.js"
            js.write_text(app_script())
            r = subprocess.run([node, "--check", str(js)], capture_output=True, text=True)
            check("the application script parses", r.returncode, 0)
    else:
        skip("javascript syntax", "node not installed")

    src = source()
    check("GPL notice present", "GNU General Public License" in src, True)
    # LibreJS needs the magnet marker to recognise the page as free software.
    check("LibreJS marker present", "@license" in src, True)
    # The claim is that the app makes no third-party requests, so look at what
    # actually loads something -- not at prose. Comments carry attribution
    # links (jsQR's homepage) that fetch nothing.
    loaders = []
    loaders += re.findall(r"""<(?:script|img|iframe|source)[^>]*\ssrc=["\']([^"\']+)""", src)
    loaders += re.findall(r"""<link[^>]*\shref=["\']([^"\']+)""", src)
    loaders += re.findall(r"""@import\s+["\']([^"\']+)""", src)
    loaders += re.findall(r"""url\((["\']?)(https?://[^)"\']+)""", src)
    loaders = [u[1] if isinstance(u, tuple) else u for u in loaders]
    external = sorted({u for u in loaders
                       if u.startswith("http") and "niclick.org" not in u})
    check("nothing off-origin is loaded", external, [])


# ── behaviour, in a real browser ─────────────────────────────────────────
def browser():
    for name in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable"):
        found = shutil.which(name)
        if found:
            return found
    return None


DRIVER = """<!doctype html><meta charset="utf-8"><title>pending</title>
<script>
const out=[];
function ok(n,got,want){ out.push((String(got)===String(want)?'ok|':'FAIL|')+n+'|'+got+'|'+want); }
localStorage.setItem('tp4_state', JSON.stringify(%(state)s));
const f=document.createElement('iframe');
f.style.cssText='width:402px;height:874px;border:0';
f.src='index.html';
addEventListener('DOMContentLoaded',()=>document.body.appendChild(f));
setTimeout(()=>{
  try{ const w=f.contentWindow, d=f.contentDocument; %(body)s }
  catch(e){ out.push('FAIL|driver threw|'+e.message+'|-'); }
  document.title=out.join('~');
}, 2000);
</script>"""


def drive(state, body, timeout=90):
    """Run assertions inside the real app and return them."""
    chrome = browser()
    with tempfile.TemporaryDirectory() as d:
        work = Path(d)
        shutil.copy(INDEX, work / "index.html")
        # A literal </script> anywhere in the state -- an exercise note, say --
        # would close the inline script tag that embeds it and break the whole
        # driver silently. Escaping the slash keeps the JSON identical to the
        # parser while hiding the tag from the HTML tokenizer.
        embedded = json.dumps(state).replace("</", "<\\/")
        (work / "driver.html").write_text(DRIVER % {"state": embedded, "body": body})
        srv = subprocess.Popen([sys.executable, "-m", "http.server", "8771", "--bind", "127.0.0.1"],
                               cwd=work, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            subprocess.run(["python3", "-c",
                            "import socket,time\n"
                            "for _ in range(50):\n"
                            "    try:\n"
                            "        socket.create_connection(('127.0.0.1',8771),0.1).close(); break\n"
                            "    except OSError: time.sleep(0.1)"], check=False)
            r = subprocess.run([chrome, "--headless", "--disable-gpu", "--no-sandbox",
                                "--virtual-time-budget=30000", "--window-size=402,874",
                                "--dump-dom", "http://127.0.0.1:8771/driver.html"],
                               capture_output=True, text=True, timeout=timeout)
        finally:
            srv.terminate()
    m = re.search(r"<title>([^<]*)</title>", r.stdout)
    return m.group(1).split("~") if m and m.group(1) != "pending" else []


def report(results, label):
    if not results:
        check(f"{label}: the driver reported back", False, True)
        return
    for row in results:
        parts = row.split("|")
        if len(parts) == 4:
            check(parts[1], parts[2], parts[3] if parts[0] == "ok" else parts[3])


DEMO = {
    "schema": 3, "globalPauseSecs": 75, "lang": "en", "activePlanId": "p1",
    "plans": [{"id": "p1", "name": "Plan", "phases": [{"id": "ph", "name": "S", "colorIdx": 0}],
               "exercises": [
                   {"id": "x1", "phaseId": "ph", "icon": "1", "name": "Bench", "muscle": "chest",
                    "type": "reps", "sets": 3, "reps": "8", "sithoehe": "", "kg": "60",
                    "pauseSecs": None, "durationSecs": 300, "note": ""},
                   {"id": "x2", "phaseId": "ph", "icon": "2", "name": "Row", "muscle": "cardio",
                    "type": "time", "sets": 1, "reps": "", "sithoehe": "", "kg": "",
                    "pauseSecs": None, "durationSecs": 480, "note": ""}]}],
    "globalExercises": [], "progress": {}, "history": [],
}


def test_timers_survive_a_locked_screen():
    print("\ntimers (browser)")
    if not browser():
        skip("timer behaviour", "no chromium found")
        return
    # Locking an iPhone looks exactly like the clock moving on while no JS
    # ran. Every timer must be derived from the clock, not counted down.
    body = """
      const REAL=Date.now(); let off=0;
      w.Date.now = () => REAL + off;
      w.playBeep=()=>{}; w.vibrate=()=>{};
      w.startWithPlan('p1'); w.openDetail('x1');
      w.startPauseTimer(75);
      ok('rest shows its full length', d.getElementById('tovNum').textContent, 75);
      off=40000; w.tickAll();
      ok('rest catches up after 40s away', d.getElementById('tovNum').textContent, 35);
      off=80000; w.tickAll();
      ok('rest closes once elapsed', d.getElementById('timerOverlay').classList.contains('active'), false);
      off=0; w.openDetail('x2');
      ok('countdown starts at its duration', d.getElementById('et-disp').textContent, '8:00');
      w.etToggle(480); off=100000; w.tickAll();
      ok('countdown follows the clock', d.getElementById('et-disp').textContent, '6:20');
      w.etToggle(480); off=900000; w.tickAll();
      ok('a held countdown does not drift', d.getElementById('et-disp').textContent, '6:20');
      w.openDetail('x1'); w.swToggle('x1',1);
      off=900000+65000; w.tickAll();
      ok('stopwatch follows the clock', d.getElementById('sw-t-x1-1').textContent, '1:05');
    """
    report(drive(DEMO, body), "timers")


def test_duration_migration():
    print("\nduration migration (browser)")
    if not browser():
        skip("duration migration", "no chromium found")
        return
    old = json.loads(json.dumps(DEMO))
    old["schema"] = 2
    for e in old["plans"][0]["exercises"]:
        e.pop("durationSecs", None)
    old["plans"][0]["exercises"][1]["durationMin"] = "5-10"
    old["plans"][0]["exercises"][0]["durationMin"] = "12"
    body = """
      const S=JSON.parse(localStorage.getItem('tp4_state'));
      ok('schema reaches the current version', S.schema, 4);
      ok('a range collapses to its first number', S.plans[0].exercises[1].durationSecs, 300);
      ok('a plain value converts', S.plans[0].exercises[0].durationSecs, 720);
    """
    report(drive(old, body), "migration")


def test_quoted_text_survives_editing():
    print("\nquotes in user text (browser)")
    if not browser():
        skip("quoted text", "no chromium found")
        return
    # A double quote ends a value="" attribute early, so everything after it is
    # dropped -- and only when the field is next opened and saved, which makes
    # it look like the app ate the text at random.
    quoted = json.loads(json.dumps(DEMO))
    plan = quoted["plans"][0]
    plan["phases"][0]["name"] = 'Core "hard"'
    plan["exercises"][0]["name"] = 'Bench "flat"'
    plan["exercises"][0]["note"] = 'Seat "3", pad low'
    plan["exercises"][0]["kg"] = '60 "plates"'
    body = """
      w.openPlanDetail('p1'); w.showPlanTab('phases');
      const pi=d.querySelector('#ptab-phases input');
      ok('phase name renders whole', pi.value, 'Core \\"hard\\"');
      w.renamePhase('ph', pi.value);
      ok('phase name survives a save', w.eval('state').plans[0].phases[0].name, 'Core \\"hard\\"');

      w.showPlanTab('exercises'); w.openEditPlanEx('x1');
      ok('exercise name renders whole', d.getElementById('mce-name').value, 'Bench \\"flat\\"');
      ok('note renders whole', d.getElementById('mce-note').value, 'Seat \\"3\\", pad low');
      ok('weight renders whole', d.getElementById('mce-kg').value, '60 \\"plates\\"');
      w.savePlanEx();
      const e=w.eval('state').plans[0].exercises.find(x=>x.id==='x1');
      ok('exercise name survives an unchanged save', e.name, 'Bench \\"flat\\"');
      ok('note survives an unchanged save', e.note, 'Seat \\"3\\", pad low');

      w.startWithPlan('p1'); w.openDetail('x1'); w.openAdjust();
      ok('adjust-for-today shows the whole weight',
         d.getElementById('adj-kg').value, '60 \\"plates\\"');
    """
    report(drive(quoted, body), "quotes")


def test_user_text_cannot_inject_markup():
    print("\nmarkup in user text (browser)")
    if not browser():
        skip("markup escaping", "no chromium found")
        return
    # Names and notes arrive from an imported file. Unescaped, one can put an
    # event handler into the page, and this app's whole claim is that it makes
    # no network requests -- which a single injected tag would break.
    evil = json.loads(json.dumps(DEMO))
    plan = evil["plans"][0]
    plan["name"] = 'Push <Heavy> & Pull'
    plan["phases"][0]["name"] = 'Warm <b>up</b>'
    plan["exercises"][0]["name"] = '<img src=x onerror="window.__pwned=1">'
    plan["exercises"][0]["note"] = '<script>window.__pwned=2</script>'
    plan["exercises"][0]["kg"] = '<b>60</b>'
    plan["exercises"][0]["muscle"] = '<i>Brust</i>'
    evil["globalExercises"] = [dict(plan["exercises"][0], id="g1")]
    evil["history"] = [{"id": "h1", "ts": "2026-09-01T10:00:00Z",
                        "plan": 'Push <Heavy> & Pull', "planId": "p1",
                        "totalExercises": 1, "doneExercises": 1, "totalSets": 3,
                        "exercises": [dict(plan["exercises"][0], setsCompleted=3, done=True)]}]
    body = """
      // Every surface that renders a name, a note or a weight.
      w.showScreen('settings'); w.showSettingsTab('plans');
      w.showSettingsTab('globalex');
      w.showScreen('workout'); w.startWithPlan('p1');
      w.openDetail('x1');
      w.showScreen('history'); w.openHistoryDetail('h1');
      w.openPlanDetail('p1'); w.showPlanTab('exercises'); w.showPlanTab('phases');

      // Not asserting on a global the handler would set: an onerror fires
      // asynchronously, after these synchronous checks, so that assertion
      // passes even when the injection worked. The element never existing is
      // the property that is actually checkable here.
      ok('no img element was created', d.querySelectorAll('img').length, 0);
      ok('no script landed in the rendered content', d.querySelectorAll('#app-scroll script').length, 0);

      // Text, not markup: each surface shows the characters and parses no
      // elements out of them. textContent rather than innerText, which only
      // reports what happens to be visible.
      w.openPlanDetail('p1'); w.showPlanTab('exercises');
      const row = d.querySelector('.plan-ex-name');
      ok('plan editor shows the name literally',
         row.textContent.indexOf('<img src=x onerror=') >= 0, true);
      ok('plan editor parsed no element out of it', row.querySelectorAll('*').length, 0);

      w.showScreen('settings'); w.showSettingsTab('plans');
      ok('settings shows the plan name literally',
         d.querySelector('.card-name').textContent, 'Push <Heavy> & Pull');

      // The exercise library prints the muscle label, and muscleLabel hands
      // back an unrecognised value verbatim -- so it is user text too. This
      // surface was missed the first time round.
      w.showScreen('settings'); w.showSettingsTab('globalex');
      const lib = d.querySelector('#gex-list .gex-title');
      ok('the library shows the muscle literally',
         lib.textContent.indexOf('<i>Brust</i>') >= 0, true);
      ok('the library parsed no element out of it',
         lib.querySelectorAll('i').length, 0);

      w.showScreen('history'); w.openHistoryDetail('h1');
      const hd = d.querySelector('.hd-ex-name');
      ok('history shows the name literally',
         hd.textContent.indexOf('<img src=x onerror=') >= 0, true);
      ok('history parsed no element out of it', hd.querySelectorAll('*').length, 0);
    """
    report(drive(evil, body), "escaping")


def test_imported_fields_cannot_inject_markup():
    print("\nmarkup in imported fields (browser)")
    if not browser():
        skip("field escaping", "no chromium found")
        return
    # The fields the first pass missed: phase names, the numbers-that-are-
    # really-strings (kg, reps, seat, sets, history counters) and history's
    # pre-`ts` date/time fallback. All arrive verbatim from an imported file.
    # Each payload names its field, so a leak reports which one.
    def tag(f):
        return f'<img src=x data-f={f}>'
    evil = json.loads(json.dumps(DEMO))
    plan = evil["plans"][0]
    plan["phases"] = [{"id": "ph", "name": tag("phase"), "colorIdx": 0},
                      {"id": "ph2", "name": tag("nextphase"), "colorIdx": 1}]
    x1 = plan["exercises"][0]
    x1.update(kg=tag("kg"), reps=tag("reps"), sithoehe=tag("seat"))
    plan["exercises"][1]["phaseId"] = "ph2"
    plan["exercises"].append(dict(x1, id="x3", phaseId="ph2", name="Squat",
                                  kg="", reps="5", sithoehe="", sets=tag("sets")))
    evil["globalExercises"] = [dict(x1, id="g1", name="Lib")]
    evil["history"] = [{"id": "h1", "date": tag("date"), "time": tag("time"),
                        "plan": tag("plan"), "planId": "p1",
                        "totalExercises": 1, "doneExercises": tag("done"),
                        "totalSets": tag("totalsets"),
                        "exercises": [
                            {"name": "Bench", "muscle": "chest", "type": "reps", "sets": 3,
                             "setsCompleted": 3, "done": True,
                             "reps": tag("hreps"), "kg": tag("hkg")}]}]
    body = """
      // Checked after every surface: a later render replaces an earlier one's
      // innerHTML, so a single count at the end would miss most leaks.
      const leaked=()=>Array.from(d.querySelectorAll('img')).map(i=>i.dataset.f).join(',');

      w.startWithPlan('p1');
      ok('workout list: no field became an element', leaked(), '');
      w.openDetail('x1'); w.showNextExerciseBanner('x2');
      ok('exercise detail and next banner: no field became an element', leaked(), '');
      w.openDetail('x3');
      ok('detail of an exercise with odd sets: no element', leaked(), '');
      w.openDetail('x1'); w.openAdjust();
      ok('adjust-for-today: no field became an element', leaked(), '');
      w.closeModal('modalAdjust');

      w.openPlanDetail('p1'); w.showPlanTab('exercises');
      ok('plan editor list: no field became an element', leaked(), '');
      w.openEditPlanEx('x3');
      ok('plan exercise editor: no field became an element', leaked(), '');
      ok('the editor keeps the sets value as typed',
         d.getElementById('mce-sets').getAttribute('value'), '<img src=x data-f=sets>');
      w.openAddExToPlan();
      ok('add-from-library: no field became an element', leaked(), '');

      w.showScreen('history');
      ok('history list: no field became an element', leaked(), '');
      w.openHistoryDetail('h1');
      ok('history detail: no field became an element', leaked(), '');
      ok('history detail shows the plan name literally',
         d.querySelector('#hd-info').textContent.indexOf('<img src=x data-f=plan>') >= 0, true);
    """
    report(drive(evil, body), "field escaping")


def test_stranded_data_is_repaired():
    print("\nrepair of stranded data (browser)")
    if not browser():
        skip("stale repair", "no chromium found")
        return
    # What the import bug left behind: schema 3 written over data that was
    # never migrated, so both earlier migrations skip it for good.
    stale = json.loads(json.dumps(DEMO))
    stale["schema"] = 3
    ex = stale["plans"][0]["exercises"]
    ex[0]["muscle"] = "Brust"
    ex[1].pop("durationSecs")
    ex[1]["durationMin"] = "10"
    ex[1]["muscle"] = "Ausdauer"
    stale["globalExercises"] = [{"id": "g1", "name": "Gx", "muscle": "Rücken",
                                 "type": "time", "durationMin": "7"}]
    stale["history"] = [{"id": "h1", "ts": "2026-09-01T10:00:00Z", "plan": "P",
                         "exercises": [{"id": "x2", "name": "Row", "muscle": "Beine",
                                        "type": "time", "durationMin": "20-30"}]}]
    stale["progress"] = {"p1": {"completedSets": {}, "doneExercises": [],
                                "overrides": {"x2": {"durationMin": "3"}}}}
    body = """
      const S=JSON.parse(localStorage.getItem('tp4_state'));
      ok('schema advances', S.schema, 4);
      ok('a stranded duration is filled', S.plans[0].exercises[1].durationSecs, 600);
      ok('a stranded muscle becomes a key', S.plans[0].exercises[0].muscle, 'chest');
      ok('the exercise library is repaired too', S.globalExercises[0].durationSecs, 420);
      ok('history is repaired too', S.history[0].exercises[0].durationSecs, 1200);
      ok('a history muscle becomes a key', S.history[0].exercises[0].muscle, 'legs');
      ok('a session override is repaired', S.progress.p1.overrides.x2.durationSecs, 180);
      ok('nothing already correct was disturbed', S.plans[0].exercises[0].durationSecs, 300);
      ok('no field was dropped', S.plans[0].exercises[1].durationMin, '10');
    """
    report(drive(stale, body), "repair")

    # Idempotent: a state already at 4 comes back byte-identical.
    current = json.loads(json.dumps(DEMO))
    current["schema"] = 4
    body2 = """
      const before = %s;
      const S = JSON.parse(localStorage.getItem('tp4_state'));
      ok('an already-current state is untouched',
         JSON.stringify(S), JSON.stringify(before));
    """ % json.dumps(current)
    report(drive(current, body2), "idempotence")


def test_deleting_an_exercise_clears_its_progress():
    print("\ndeleting an exercise (browser)")
    if not browser():
        skip("delete clears progress", "no chromium found")
        return
    done = json.loads(json.dumps(DEMO))
    done["progress"] = {"p1": {"completedSets": {"x1": 3, "x2": 1},
                               "doneExercises": ["x1", "x2"],
                               "overrides": {"x1": {"kg": "70"}}}}
    body = """
      w.startWithPlan('p1');
      ok('both exercises count as done', d.getElementById('prTxt').textContent, '100%');
      w.openPlanDetail('p1'); w.showPlanTab('exercises');
      // Stub confirm for BOTH deletes. A real one blocks headless forever.
      const realConfirm=w.confirm; w.confirm=()=>true;
      w.deletePlanEx('x2');
      const P=w.eval('state').progress.p1;
      ok('its completed sets are gone', P.completedSets.x2===undefined, true);
      ok('it is off the done list', P.doneExercises.indexOf('x2'), -1);
      ok('the surviving exercise keeps its progress', P.completedSets.x1, 3);
      ok('its own override survives', P.overrides.x1.kg, '70');
      ok('the ring does not overshoot', d.getElementById('prTxt').textContent, '100%');
      w.deletePlanEx('x1');
      w.confirm=realConfirm;
      ok('deleting the last one clears it too', w.eval('state').progress.p1.doneExercises.length, 0);
      ok('and the ring reads zero', d.getElementById('prTxt').textContent, '0%');
    """
    report(drive(done, body), "delete")


def test_adjusting_keeps_a_hand_completed_exercise_done():
    print("\nadjust keeps done (browser)")
    if not browser():
        skip("adjust keeps done", "no chromium found")
        return
    body = """
      w.startWithPlan('p1'); w.openDetail('x1');
      w.markExDone();
      ok('marked done with no sets ticked', w.isDone('x1'), true);

      // Change only the weight. This used to withdraw "done" silently,
      // because completed sets were still below the planned count.
      w.openAdjust();
      d.getElementById('adj-kg').value='50';
      w.saveAdjust();
      ok('still done after changing the weight', w.isDone('x1'), true);
      ok('the adjustment was recorded', w.getEx('x1').kg, '50');

      // Raising the set count does add work that is not ticked off, so
      // withdrawing it there is right.
      w.openDetail('x1'); w.openAdjust();
      d.getElementById('adj-sets').value='5';
      w.saveAdjust();
      ok('adding sets does withdraw it', w.isDone('x1'), false);

      // And a normally finished exercise is unaffected by a weight change.
      w.openDetail('x2');
      w.openDetail('x1');
      w.completeSet('x1',1); w.completeSet('x1',2); w.completeSet('x1',3);
      w.completeSet('x1',4); w.completeSet('x1',5);
      ok('finishing every set marks it done', w.isDone('x1'), true);
      w.openAdjust(); d.getElementById('adj-kg').value='55'; w.saveAdjust();
      ok('and a weight change leaves it done', w.isDone('x1'), true);
    """
    report(drive(DEMO, body), "adjust")


def _with_history(sessions):
    st = json.loads(json.dumps(DEMO))
    st["history"] = sessions
    return st


def _session(sid, ts, kg, sets=3, reps="8", name="Bench", exid="x1"):
    return {"id": sid, "ts": ts, "plan": "Plan", "planId": "p1",
            "totalExercises": 1, "doneExercises": 1, "totalSets": sets,
            "exercises": [{"id": exid, "name": name, "muscle": "chest",
                           "type": "reps", "sets": sets, "reps": reps, "kg": kg,
                           "setsCompleted": sets, "done": True}]}


def test_last_time_is_shown():
    print("\nlast time (browser)")
    if not browser():
        skip("last time", "no chromium found")
        return
    # Newest first, the way the app stores history.
    st = _with_history([_session("s2", "2026-09-12T18:00:00Z", "60"),
                        _session("s1", "2026-09-05T18:00:00Z", "55")])
    body = """
      w.startWithPlan('p1'); w.openDetail('x1');
      const box=d.getElementById('d-last');
      ok('the panel is shown', box.style.display !== 'none', true);
      ok('it reports the most recent session, not the oldest',
         box.textContent.indexOf('60 kg') >= 0, true);
      ok('it does not report the older one', box.textContent.indexOf('55 kg'), -1);
      ok('it shows the set shape', box.textContent.indexOf('3\u00d78') >= 0, true);

      // An exercise never done before has nothing to say.
      w.openDetail('x2');
      ok('a first-ever exercise shows nothing',
         d.getElementById('d-last').style.display, 'none');
    """
    report(drive(st, body), "last time")

    # Matched by name as well as id, since deleting and re-adding an exercise
    # gives it a new id while remaining the same movement.
    renamed = _with_history([_session("s1", "2026-09-05T18:00:00Z", "52", exid="gone")])
    body2 = """
      w.startWithPlan('p1'); w.openDetail('x1');
      ok('a re-created exercise still finds its history',
         d.getElementById('d-last').textContent.indexOf('52 kg') >= 0, true);
    """
    report(drive(renamed, body2), "last time by name")


def test_a_personal_best_is_marked():
    print("\npersonal best (browser)")
    if not browser():
        skip("personal best", "no chromium found")
        return
    def run(kg_now, past, label, expect):
        st = _with_history(past)
        st["plans"][0]["exercises"][0]["kg"] = kg_now
        body = """
          w.startWithPlan('p1'); w.openDetail('x1');
          ok('%s', d.getElementById('d-last').textContent.indexOf('\u2605') >= 0, %s);
        """ % (label, "true" if expect else "false")
        report(drive(st, body), label)

    past = [_session("s1", "2026-09-05T18:00:00Z", "55")]
    run("60", past, "heavier than before is marked", True)
    run("55", past, "equalling it is not", False)
    run("50", past, "lighter is not", False)
    run("60", [], "a first-ever session is not", False)


def test_a_skipped_exercise_is_not_last_time():
    print("\nlast time skips undone rows (browser)")
    if not browser():
        skip("last time skips undone rows", "no chromium found")
        return
    # Finishing a workout writes a row for every exercise in the plan, done or
    # not. The newer session here is one where Bench was never touched; it
    # must not be reported as "last time", nor hide a real new best.
    skipped = _session("s2", "2026-09-20T18:00:00Z", "80")
    skipped["exercises"][0].update(setsCompleted=0, done=False)
    done = _session("s1", "2026-09-10T18:00:00Z", "57,5")
    st = _with_history([skipped, done])
    body = """
      w.startWithPlan('p1'); w.openDetail('x1');
      const txt=d.getElementById('d-last').textContent;
      const st=w.eval('state');
      ok('the untouched session is not reported', txt.indexOf('80 kg'), -1);
      ok('the last session actually done is', txt.indexOf('57,5 kg') >= 0, true);
      ok('with its own date', txt.indexOf(w.entryDate(st.history[1])) >= 0, true);
      ok('and its sets', txt.indexOf('3\u00d78') >= 0, true);
      ok('60 kg is a new best over 57,5', txt.indexOf('\u2605') >= 0, true);
    """
    report(drive(st, body), "skipped row")

    # Starting a workout and finishing it straight away used to make
    # "Last time ... today" appear with the plan's own numbers.
    body2 = """
      w.confirm=()=>true;
      w.startWithPlan('p1'); w.finishWorkout();
      ok('the empty workout was recorded', w.eval('state').history.length, 1);
      w.startWithPlan('p1'); w.openDetail('x1');
      ok('an empty workout gives no last time',
         d.getElementById('d-last').style.display, 'none');
    """
    report(drive(DEMO, body2), "empty workout")

    # What still counts: a timed exercise marked done (it has no sets), a
    # partly done one, and a row from before setsCompleted/done were stored.
    timed = _session("s3", "2026-09-20T18:00:00Z", "", name="Row", exid="x2")
    timed["exercises"][0].update(type="time", durationSecs=480, setsCompleted=0, done=True)
    partial = _session("s4", "2026-09-21T18:00:00Z", "50")
    partial["exercises"][0].update(setsCompleted=1, done=False)
    body3 = """
      w.startWithPlan('p1'); w.openDetail('x2');
      ok('a timed exercise marked done is reported',
         d.getElementById('d-last').textContent.indexOf('8:00') >= 0, true);
      w.openDetail('x1');
      const txt=d.getElementById('d-last').textContent;
      ok('a partly done session is reported', txt.indexOf('50 kg') >= 0, true);
      ok('with the sets actually done', txt.indexOf('1\u00d78') >= 0, true);
    """
    report(drive(_with_history([partial, timed]), body3), "done rows")

    legacy = _session("s5", "2026-09-01T18:00:00Z", "45")
    del legacy["exercises"][0]["setsCompleted"]
    del legacy["exercises"][0]["done"]
    body4 = """
      w.startWithPlan('p1'); w.openDetail('x1');
      ok('a row older than setsCompleted is still trusted',
         d.getElementById('d-last').textContent.indexOf('45 kg') >= 0, true);
    """
    report(drive(_with_history([legacy]), body4), "legacy row")


def test_rest_can_be_adjusted_while_running():
    print("\nadjusting the rest (browser)")
    if not browser():
        skip("rest adjust", "no chromium found")
        return
    body = """
      const REAL=Date.now(); let off=0;
      w.Date.now=()=>REAL+off;
      w.playBeep=()=>{}; w.vibrate=()=>{};
      const num=()=>d.getElementById('tovNum').textContent;
      const up=()=>d.getElementById('timerOverlay').classList.contains('active');

      w.startWithPlan('p1'); w.openDetail('x1');
      w.startPauseTimer(75);
      w.adjustRest(30);
      ok('+30 adds to the remaining time', num(), 105);
      w.adjustRest(-30); w.adjustRest(-30);
      ok('-30 takes it away', num(), 45);

      // The deadline moved, not a counter, so it still catches up after a lock.
      off=20000; w.tickAll();
      ok('an adjusted rest still follows the clock', num(), 25);

      w.adjustRest(-30);
      ok('shortening past zero ends the rest', up(), false);

      // With no rest running there is nothing to adjust, and nothing breaks.
      w.adjustRest(30);
      ok('adjusting with no rest running is a no-op', up(), false);

      // Extending past the original length keeps the ring within bounds.
      off=0; w.startPauseTimer(60); w.adjustRest(30);
      const dash=parseFloat(d.getElementById('tovBar').style.strokeDashoffset);
      ok('the ring is not drawn past full', dash>=0, true);
    """
    report(drive(DEMO, body), "rest adjust")


def test_the_library_can_be_filtered():
    print("\nlibrary filter (browser)")
    if not browser():
        skip("library filter", "no chromium found")
        return
    lib = json.loads(json.dumps(DEMO))
    lib["lang"] = "de"
    g = lambda i, n, m: {"id": i, "icon": "1", "name": n, "muscle": m, "type": "reps",
                         "sets": 3, "reps": "10", "kg": "", "pauseSecs": None,
                         "durationSecs": 300, "note": ""}
    # Not "Bankdrücken": it folds to "bankdrucken", which contains "ruck",
    # so it would rightly match the accent test below.
    lib["globalExercises"] = [g("a", "Butterfly", "chest"),
                              g("b", "Rückenstrecker", "back"),
                              g("c", "Kniebeuge", "legs")]
    body = """
      w.showScreen('settings'); w.showSettingsTab('globalex');
      const box=d.getElementById('gex-filter');
      const names=()=>[...d.querySelectorAll('#gex-list .gex-title span:nth-child(2)')].map(e=>e.textContent);
      const find=q=>{ box.value=q; w.renderGexList(); return names(); };

      ok('the filter is offered once there is a library', box.style.display, '');
      ok('everything shows with no query', names().length, 3);
      ok('it narrows on the name', JSON.stringify(find('knie')), JSON.stringify(['Kniebeuge']));
      ok('case does not matter', JSON.stringify(find('KNIE')), JSON.stringify(['Kniebeuge']));
      ok('an accentless query finds an accented name',
         JSON.stringify(find('ruck')), JSON.stringify(['Rückenstrecker']));
      // Matched on the label in the current language, here German.
      ok('it matches the muscle label', JSON.stringify(find('brust')), JSON.stringify(['Butterfly']));
      ok('and the stored key', JSON.stringify(find('legs')), JSON.stringify(['Kniebeuge']));
      find('zzz');
      ok('no match says so rather than looking empty',
         d.getElementById('gex-list').textContent.indexOf('Keine') >= 0, true);
      ok('clearing restores everything', find('').length, 3);
    """
    report(drive(lib, body), "filter")

    empty = json.loads(json.dumps(DEMO))
    body2 = """
      w.showScreen('settings'); w.showSettingsTab('globalex');
      ok('no filter box when the library is empty',
         d.getElementById('gex-filter').style.display, 'none');
    """
    report(drive(empty, body2), "filter empty")



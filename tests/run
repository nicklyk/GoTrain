def test_import_of_an_old_export():
    print("\nimport of an old export (browser)")
    if not browser():
        skip("import migration", "no chromium found")
        return
    # Exports written before 2026-09-10 have no schema field. Importing one
    # into a current install must still migrate it, not inherit the
    # running schema.
    old = json.loads(json.dumps(DEMO))
    del old["schema"]
    for e in old["plans"][0]["exercises"]:
        e.pop("durationSecs", None)
    old["plans"][0]["exercises"][0]["muscle"] = "Brust"
    old["plans"][0]["exercises"][1]["durationMin"] = "10"
    old["history"] = [{"id": "h1", "ts": "2026-09-01T10:00:00Z", "exercises": [
        {"id": "x2", "name": "Row", "muscle": "Cardio", "type": "time", "durationMin": "12"}]}]
    current = json.loads(json.dumps(DEMO))
    current["plans"][0]["exercises"][1]["durationSecs"] = 900
    body = """
      w.applyImport(%s);
      const S=w.eval('state');
      ok('an old import reaches the current schema', S.schema, 4);
      ok('its timed exercise keeps its length', S.plans[0].exercises[1].durationSecs, 600);
      ok('its muscle label becomes a key', S.plans[0].exercises[0].muscle, 'chest');
      ok('its history is migrated too', S.history[0].exercises[0].durationSecs, 720);
      // The first import left one workout behind and this file has none,
      // which now asks first. That question is tested on its own below.
      w.confirm=()=>true;
      w.applyImport(%s);
      ok('a current import is taken as is', w.eval('state').plans[0].exercises[1].durationSecs, 900);
      let threw=false; try{ w.applyImport({plans:'x'}); }catch(e){ threw=true; }
      ok('a malformed file is still refused', threw, true);
    """ % (json.dumps(old), json.dumps(current))
    report(drive(DEMO, body), "import")


def test_import_asks_before_shrinking_history():
    print("\nimport over a longer history (browser)")
    if not browser():
        skip("import confirmation", "no chromium found")
        return
    # An import replaces history wholesale and tp4_state is the only copy, so
    # an older backup must not silently wipe the workouts logged since.
    def workouts(n):
        return [{"id": f"h{i}", "ts": f"2026-09-0{i + 1}T10:00:00Z", "exercises": []}
                for i in range(n)]
    have = json.loads(json.dumps(DEMO))
    have["history"] = workouts(2)
    older = json.loads(json.dumps(DEMO))
    older["plans"][0]["name"] = "Older plan"
    newer = json.loads(json.dumps(DEMO))
    newer["history"] = workouts(3)
    nohist = json.loads(json.dumps(DEMO))
    del nohist["history"]
    body = """
      const older=%s, newer=%s, nohist=%s;
      const saved=localStorage.getItem('tp4_state');
      let asked=[], answer=false;
      w.confirm=m=>{ asked.push(m); return answer; };
      const clone=o=>JSON.parse(JSON.stringify(o));

      let r=w.applyImport(clone(older));
      ok('a file with fewer workouts asks first', asked.length, 1);
      ok('the question names the count in the app', asked[0].includes('In this app: 2'), true);
      ok('the question names the count in the file', asked[0].includes('In the file: 0'), true);
      ok('declining reports it', r, false);
      ok('declining keeps every workout', w.eval('state').history.length, 2);
      ok('declining keeps the plans', w.eval('state').plans[0].name, 'Plan');
      ok('declining saves nothing', localStorage.getItem('tp4_state'), saved);

      // The same through importData, which must not save or reload after a
      // no. A real FileReader never fires under --virtual-time-budget, so a
      // stand-in hands the text straight to onload.
      asked=[]; let alerted=0; w.alert=()=>{ alerted++; };
      w.FileReader=function(){ this.readAsText=s=>this.onload({target:{result:s}}); };
      w.importData({target:{files:[JSON.stringify(older)]}});
      ok('declining a picked file asks once', asked.length, 1);
      ok('declining a picked file is not an error', alerted, 0);
      ok('declining a picked file saves nothing', localStorage.getItem('tp4_state'), saved);

      w.eval("lang='de'"); asked=[];
      w.applyImport(clone(older));
      ok('the question is asked in German too', asked[0].includes('In der App: 2'), true);
      w.eval("lang='en'");

      asked=[];
      w.applyImport(clone(nohist));
      ok('a file without history asks nothing', asked.length, 0);
      ok('and leaves history alone', w.eval('state').history.length, 2);

      asked=[];
      r=w.applyImport(clone(newer));
      ok('a file with more workouts asks nothing', asked.length, 0);
      ok('and is taken', w.eval('state').history.length, 3);

      asked=[]; answer=true;
      r=w.applyImport(clone(older));
      ok('accepting reports it', r, true);
      ok('accepting imports as before', w.eval('state').history.length, 0);
      ok('accepting takes the plans too', w.eval('state').plans[0].name, 'Older plan');
    """ % (json.dumps(older), json.dumps(newer), json.dumps(nohist))
    report(drive(have, body), "import confirmation")


def test_an_import_with_unsafe_ids_is_refused():
    print("\nimport with unsafe ids (browser)")
    if not browser():
        skip("unsafe ids", "no chromium found")
        return
    # Ids are interpolated raw into value="" attributes and into onclick
    # handlers, on the assumption that the app made them. On an import they
    # come from the file. This one closes a value="" early and injects an
    # element; one in an onclick would run on the next tap.
    evil = 'ph"><img src=x id=pwned>'
    def with_id(where):
        st = json.loads(json.dumps(DEMO))
        where(st)
        return st
    cases = {
        "a phase id":      with_id(lambda s: (s["plans"][0]["phases"][0].update(id=evil),
                                              s["plans"][0]["exercises"][0].update(phaseId=evil))),
        "a plan id":       with_id(lambda s: (s["plans"][0].update(id="p');alert(1);//"),
                                              s.update(activePlanId="p');alert(1);//"))),
        "an exercise id":  with_id(lambda s: s["plans"][0]["exercises"][0].update(id="x1')//")),
        "a library id":    with_id(lambda s: s.update(globalExercises=[{"id": 'g"x', "name": "G",
                                   "type": "reps", "muscle": "chest"}])),
        "a session id":    with_id(lambda s: s.update(history=[dict(
                                   _session("h1", "2026-09-20T10:00:00Z", "70"), id="h<b>")])),
        "a progress key":  with_id(lambda s: s.update(progress={'p1"': {"completedSets": {},
                                   "doneExercises": [], "overrides": {}}})),
        "a done-list id":  with_id(lambda s: s.update(progress={"p1": {"completedSets": {},
                                   "doneExercises": ["x1'"], "overrides": {}}})),
        "a non-string id": with_id(lambda s: s["plans"][0].update(id={"x": 1})),
    }
    for label, payload in cases.items():
        body = """
          const before=localStorage.getItem('tp4_state');
          let threw=false;
          try{ w.applyImport(%s); }catch(e){ threw=true; }
          ok('%s is refused', threw, true);
          ok('%s leaves the stored state alone', localStorage.getItem('tp4_state')===before, true);
          w.openPlanDetail(w.eval('state').activePlanId||'p1'); w.showPlanTab('exercises');
          ok('%s injects nothing', d.querySelectorAll('img#pwned').length, 0);
        """ % (json.dumps(payload).replace("</", "<\\/"), label, label, label)
        report(drive(DEMO, body), label)

    # What the app and the plugin really write still goes through: uid()
    # gives seven base-36 characters, and nulls stand for "no phase".
    real = json.loads(json.dumps(DEMO))
    real["plans"][0]["exercises"][0]["phaseId"] = None
    real["history"] = [_session("0lgqxuz", "2026-09-20T10:00:00Z", "70")]
    body = """
      let threw=false;
      try{ w.applyImport(%s); }catch(e){ threw=true; }
      ok('ordinary ids and a null phaseId are accepted', threw, false);
    """ % json.dumps(real)
    report(drive(DEMO, body), "ordinary ids")


def test_a_misshapen_import_is_refused():
    print("\nimport of a misshapen file (browser)")
    if not browser():
        skip("misshapen import", "no chromium found")
        return
    # Each of these was valid JSON that used to be accepted, saved, and then
    # crash the next start or a tab. tp4_state is the only copy, so a refusal
    # must leave both the live state and the stored one exactly as they were.
    def bent(change):
        s = json.loads(json.dumps(DEMO))
        change(s)
        return s
    bad = {
        "a plan with no phases or exercises": {"activePlanId": "a", "plans": [{"id": "a", "name": "X"}]},
        "a plan whose phases are null": bent(lambda s: s["plans"][0].update(phases=None)),
        "a plan whose exercises are not a list": bent(lambda s: s["plans"][0].update(exercises={})),
        "a null plan": bent(lambda s: s["plans"].append(None)),
        "a null exercise": bent(lambda s: s["plans"][0]["exercises"].append(None)),
        "a null phase": bent(lambda s: s["plans"][0]["phases"].append(None)),
        "history that is null": bent(lambda s: s.update(history=None)),
        "history that is an object": bent(lambda s: s.update(history={})),
        "a null history entry": bent(lambda s: s.update(history=[None])),
        "a history entry whose exercises are not a list":
            bent(lambda s: s.update(history=[dict(_session("h1", "2026-09-20T10:00:00Z", "70"), exercises={})])),
        "a library that is null": bent(lambda s: s.update(globalExercises=None)),
        "a null library exercise": bent(lambda s: s.update(globalExercises=[None])),
        "progress that is null": bent(lambda s: s.update(progress=None)),
        "progress without its lists": bent(lambda s: s.update(progress={"p1": {}})),
        "a list instead of an object": [DEMO],
    }
    good = bent(lambda s: s.update(history=[_session("h9", "2026-09-20T10:00:00Z", "70")],
                                   progress={"p1": None}))
    body = """
      const bad=%s, good=%s;
      w.confirm=()=>true;
      const before=JSON.stringify(w.eval('state')), saved=localStorage.getItem('tp4_state');
      for(const [name,file] of Object.entries(bad)){
        let err=''; try{ w.applyImport(file); }catch(e){ err=e.message; }
        ok(name+' is refused', err, 'invalid');
        ok(name+' leaves the state alone', JSON.stringify(w.eval('state'))===before, true);
        ok(name+' saves nothing', localStorage.getItem('tp4_state')===saved, true);
      }
      // The same through the file picker: an error, and no save or reload.
      let alerted=0; w.alert=()=>{ alerted++; };
      w.FileReader=function(){ this.readAsText=s=>this.onload({target:{result:s}}); };
      w.importData({target:{files:[JSON.stringify(bad['a plan with no phases or exercises'])]}});
      ok('a misshapen picked file reports an error', alerted, 1);
      ok('a misshapen picked file saves nothing', localStorage.getItem('tp4_state')===saved, true);

      ok('a sound file still imports', w.applyImport(good), true);
      ok('and brings its history', w.eval('state').history[0].id, 'h9');
      // Fields a file leaves out keep the app's own value, as before.
      ok('a file without a library or progress still imports',
         w.applyImport({activePlanId:'p1', plans:good.plans}), true);
    """ % (json.dumps(bad), json.dumps(good))
    report(drive(DEMO, body), "misshapen import")


def main():
    for t in (test_translations, test_version_markers, test_service_worker_assets,
              test_manifest, test_syntax_and_licence,
              test_timers_survive_a_locked_screen, test_duration_migration,
              test_quoted_text_survives_editing, test_stranded_data_is_repaired, test_deleting_an_exercise_clears_its_progress,
              test_adjusting_keeps_a_hand_completed_exercise_done,
              test_last_time_is_shown, test_a_personal_best_is_marked,
              test_a_skipped_exercise_is_not_last_time,
              test_rest_can_be_adjusted_while_running, test_the_library_can_be_filtered, test_the_set_heading_matches_the_exercise, test_user_text_cannot_inject_markup, test_imported_fields_cannot_inject_markup,
              test_import_of_an_old_export, test_import_asks_before_shrinking_history,
              test_a_misshapen_import_is_refused, test_an_import_with_unsafe_ids_is_refused):
        t()
    print(f"\n{passed} passed, {len(failures)} failed, {skipped} skipped")
    if failures:
        print("\nfailures:")
        for f in failures:
            print(f"  {f}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
